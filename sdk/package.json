{
  "name": "convia-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Talk to a Convia installation as a signed-in person, without implementing its HTTP and event protocols.",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../api/openapi.yaml --output src/contract.ts",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "esbuild e2e/inject.ts --bundle --format=iife --target=es2023 --outfile=e2e/.built/sdk.js",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "^0.28.2",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
