# Template for the local development environment.
#
# Copy it to `.env`, which is ignored by Git:
#
#   cp .env.example .env
#
# Convia reads configuration from the process environment, not from this file.
# Load it into a shell before running the service or the tests:
#
#   set -a && . ./.env && set +a
#
# Never put a production credential in `.env`. Production configuration comes
# from the deployment environment or a secret manager.

# development applies convenient defaults. production additionally requires a
# verified TLS mode on the database URL.
CONVIA_ENVIRONMENT=development

CONVIA_HTTP_HOST=0.0.0.0
CONVIA_HTTP_PORT=8080

# Networks whose X-Forwarded-For header Convia believes, as CIDR blocks or bare
# addresses. Empty means trust nothing, which is the safe default: no caller can
# then claim another address. Set it before deploying behind a reverse proxy, or
# every client shares the proxy's address for rate-limiting purposes.
# CONVIA_TRUSTED_PROXIES=10.0.0.0/8

# Required. The values below match the local docker-compose.yml instance.
CONVIA_DATABASE_URL=postgres://convia:convia@127.0.0.1:5432/convia?sslmode=disable
CONVIA_DATABASE_MAX_CONNECTIONS=10
CONVIA_DATABASE_CONNECT_TIMEOUT=5s
CONVIA_DATABASE_QUERY_TIMEOUT=5s

# Enables the database integration tests, which are skipped when it is unset.
# They create and drop their own database, so this role must be allowed to
# create databases.
CONVIA_TEST_DATABASE_URL=postgres://convia:convia@127.0.0.1:5432/convia?sslmode=disable

# The media plane. All three are optional and go together: set none and Convia
# runs without a media plane, which is a supported deployment — rooms, calls,
# and participants all work and nobody can connect. Setting only some of them
# is refused at startup, because it is never what anybody meant.
#
# The values below match the local docker-compose.yml instance, which is opt-in:
#
#   docker compose --profile media up -d
#
# See docs/media.md.
# CONVIA_LIVEKIT_URL=http://127.0.0.1:7880
# CONVIA_LIVEKIT_API_KEY=devkey
# CONVIA_LIVEKIT_API_SECRET=a-development-secret-long-enough-to-be-accepted

# How long Convia waits for the media plane to answer. Production additionally
# requires an https URL and a secret of at least 32 characters.
# CONVIA_LIVEKIT_TIMEOUT=5s

# Where a browser reaches the media plane, when that is not where Convia
# reaches it. Leave it unset and clients are sent to the address above with the
# scheme swapped for ws, which is right when one server answers both. Set it
# when Convia reaches the media plane on a private address no client can
# resolve. Production requires wss, because this address is published to
# clients along with a bearer token.
# CONVIA_LIVEKIT_CLIENT_URL=wss://media.example

# Enables the media integration tests, which are skipped unless all three are
# set. They create and delete their own rooms, named after generated call
# identifiers, so they never collide with anything else on the server.
# CONVIA_TEST_LIVEKIT_URL=http://127.0.0.1:7880
# CONVIA_TEST_LIVEKIT_API_KEY=devkey
# CONVIA_TEST_LIVEKIT_API_SECRET=a-development-secret-long-enough-to-be-accepted

# The application that owns Convia's own product, which is the only tenant a
# browser session can ever act within. An identifier rather than a name, because
# names are not unique and there is no lookup by one: create the application once
# with the operator API, then configure its id here.
#
# Unset means nobody signs in to Convia itself and the session routes are not
# registered at all. That is a supported deployment — Convia is a platform first,
# and an instance serving only integrations has no use for them.
#
# Accounts are created with `convia account create`; there is no self-service
# sign-up, because open registration needs email verification and Convia has no
# mailer. See docs/sessions.md.
# CONVIA_FIRST_PARTY_APPLICATION=app_MXHJAY4MJNX2FO22XWJ3XNCKHT

# Where this instance reaches the Redis it shares with the other instances of
# the same deployment. Two things use it: the channel that carries control
# events between instances, and the store that holds presence.
#
# Unset means there are no other instances, which is what a local process is and
# what a single-instance deployment is. Everything works: every event-stream
# subscriber is served by the instance that produced the event, and presence is
# held in the process that was told about it.
#
# Several instances with this unset is the one configuration that is quietly
# wrong — each would serve only its own subscribers and hold only its own
# presence, and it would look like it worked. Convia cannot detect that from
# inside one process; docs/events.md and docs/presence.md state it as an
# operational requirement.
#
# The value below matches the local docker-compose.yml instance, which is
# opt-in:
#
#   docker compose --profile shared up -d
#
# Nothing durable is ever written here. The events are carried over
# publish/subscribe, which stores nothing at all; presence is the only thing
# that writes a key, and every one of them expires. Production requires rediss,
# because both carry the affairs of every tenant on the deployment between
# machines.
# CONVIA_REDIS_URL=redis://127.0.0.1:6379/0
# CONVIA_REDIS_TIMEOUT=3s

# Enables the integration tests that need Redis, which are skipped unless it is
# set: carrying events between instances, and presence converging across them.
#
# Point it at a database of its own. The relay tests use a channel of their own
# and store nothing, but the presence tests empty the database they run in,
# which is how one test's expired claims are kept out of another's sweep.
# CONVIA_TEST_REDIS_URL=redis://127.0.0.1:6379/1
