# Template for the local development environment.
#
# Copy it to `.env`, which is ignored by Git:
#
#   cp .env.example .env
#
# Convia reads configuration from the process environment, not from this file.
# Load it into a shell before running the service or the tests:
#
#   set -a && . ./.env && set +a
#
# Never put a production credential in `.env`. Production configuration comes
# from the deployment environment or a secret manager.

# development applies convenient defaults. production additionally requires a
# verified TLS mode on the database URL.
CONVIA_ENVIRONMENT=development

CONVIA_HTTP_HOST=0.0.0.0
CONVIA_HTTP_PORT=8080

# Networks whose X-Forwarded-For header Convia believes, as CIDR blocks or bare
# addresses. Empty means trust nothing, which is the safe default: no caller can
# then claim another address. Set it before deploying behind a reverse proxy, or
# every client shares the proxy's address for rate-limiting purposes.
CONVIA_TRUSTED_PROXIES=10.0.0.0/8

# How many requests one application may make in a minute, successes included.
# Counted per application rather than per key or per address, because a tenant
# issues its own keys. The default is a ceiling rather than a throttle: far
# above what serving conversations needs, far below what starving the other
# tenants needs. Between 60 and 1000000; there is no value that turns it off.
CONVIA_TENANT_REQUESTS_PER_MINUTE=3000

# How often one signed-in session may ask, successes included. Per session
# rather than per account or per address: an address is shared by a household,
# an account is shared by somebody's own devices, and a session is held by
# exactly one holder -- so a stolen session's flood never throttles the phone it
# was stolen from. Six hundred a minute is deliberately generous; what it bounds
# is a stolen session reading an installation faster than anybody could.
CONVIA_PERSON_REQUESTS_PER_MINUTE=600

# How long a deleted user is kept before Convia forgets them: the external
# subject freed, the name and the metadata gone, and what they wrote redacted.
# It is a promise in both directions -- how long a deletion stays recoverable,
# and the outer bound on how long Convia keeps somebody it was told to forget.
# Between 24h and 87600h. Erasure cannot be undone, so a short window is not a
# tidier deployment, it is less time for anybody to notice a mistake.
CONVIA_ERASURE_WINDOW=720h

# The lowest severity Convia writes: debug, info, warn or error. A value that is
# none of those stops startup rather than falling back, because somebody who
# wrote "verbose" meant something. Debug is not a setting to leave on: those
# lines name identifiers and the shape of what somebody is doing, which is the
# social graph docs/data-protection.md classifies.
CONVIA_LOG_LEVEL=info

# What tells two Convia processes apart in the logs. Empty means the hostname,
# which is right in a container and adequate anywhere else. Set it when running
# two on one host, or both answer to the same name and the logs cannot be told
# apart afterwards.
CONVIA_SERVICE_INSTANCE=

# Where measurements are sent, over OTLP/HTTP. Empty is off, and off is a real
# no-op: no collection, no accumulation, no flush, so a laptop pays nothing for
# telemetry it never asked for. It is named CONVIA_ rather than reusing
# OpenTelemetry's own variable, because a deployment that sets the standard one
# is usually setting it for several processes at once.
CONVIA_METRICS_ENDPOINT=https://collector.internal:4318

# Where spans are sent, over OTLP/HTTP. Empty is off, and off is a real no-op.
# Separate from the metrics endpoint because the two are separate decisions:
# metrics are cheap and constant and a deployment usually wants them always,
# while traces are voluminous and are turned on while somebody is looking at
# something. One setting would make turning one off turn the other off with it.
CONVIA_TRACES_ENDPOINT=https://collector.internal:4318

# The share of traces Convia starts that it keeps, from 0 to 1. One is every
# trace and is the default: sampling that throws away the trace somebody needed
# is worse than a collector that costs a little more. A caller that already
# decided to record an operation gets Convia's part of it whatever this says,
# because a sampled trace with Convia missing from the middle looks like Convia
# did nothing. A value outside 0 to 1 stops startup rather than being clamped.
CONVIA_TRACE_SAMPLE=1

# Whether invitation links between installations may reach loopback and private
# network addresses, such as a second Convia on this machine or on this network.
# Off by default in every environment, development included: while it is on,
# anybody who can create an account here can make this server connect to the
# machines around it. Turn it on to try two installations locally.
CONVIA_PEERS_ALLOW_PRIVATE_ADDRESSES=true

# The address other installations reach this one at, as a scheme and host with
# no path. It is what an invitation link names.
#
# Unset, a link names the address the request that made it arrived at, which is
# right for one machine on one network and wrong behind a reverse proxy or when
# an administrator opens Convia at an address only that machine can reach.
# Setting it does not relax the rule that a proxy must pass Host through
# unchanged: signed requests from other installations are still checked
# against it.
CONVIA_PUBLIC_ADDRESS=https://convia.example

# Required. The values below match the local docker-compose.yml instance.
CONVIA_DATABASE_URL=postgres://convia:convia@127.0.0.1:5432/convia?sslmode=disable
CONVIA_DATABASE_MAX_CONNECTIONS=10
CONVIA_DATABASE_CONNECT_TIMEOUT=5s
CONVIA_DATABASE_QUERY_TIMEOUT=5s

# Enables the database integration tests, which are skipped when it is unset.
# They create and drop their own database, so this role must be allowed to
# create databases.
CONVIA_TEST_DATABASE_URL=postgres://convia:convia@127.0.0.1:5432/convia?sslmode=disable

# The media plane. All three are optional and go together: set none and Convia
# runs without a media plane, which is a supported deployment — rooms, calls,
# and participants all work and nobody can connect. Setting only some of them
# is refused at startup, because it is never what anybody meant.
#
# The values below match the local docker-compose.yml instance, which is opt-in:
#
#   docker compose --profile media up -d
#
# See docs/media.md.
#
# The media server must also be told to report to this instance at
# /media/reports, signed with the same key; without it, a browser that crashes
# stays in its call as far as Convia knows. The local instance is configured to
# report to http://host.docker.internal:8080/media/reports.
CONVIA_LIVEKIT_URL=http://127.0.0.1:7880
CONVIA_LIVEKIT_API_KEY=devkey
CONVIA_LIVEKIT_API_SECRET=a-development-secret-long-enough-to-be-accepted

# How long Convia waits for the media plane to answer. Production additionally
# requires an https URL and a secret of at least 32 characters.
CONVIA_LIVEKIT_TIMEOUT=5s

# Where a browser reaches the media plane, when that is not where Convia
# reaches it. Leave it unset and clients are sent to the address above with the
# scheme swapped for ws, which is right when one server answers both. Set it
# when Convia reaches the media plane on a private address no client can
# resolve. Production requires wss, because this address is published to
# clients along with a bearer token.
CONVIA_LIVEKIT_CLIENT_URL=wss://media.example

# Only while rotating the media key: the pair being retired. Reports LiveKit
# signs with it are still believed; nothing Convia mints is signed with it. Set
# both or neither, and remove them once LiveKit no longer knows the old key.
# See docs/runbooks/rotating-secrets.md.
CONVIA_LIVEKIT_PREVIOUS_API_KEY=oldkey
CONVIA_LIVEKIT_PREVIOUS_API_SECRET=the-secret-being-retired

# Enables the media integration tests, which are skipped unless all three are
# set. They create and delete their own rooms, named after generated call
# identifiers, so they never collide with anything else on the server.
CONVIA_TEST_LIVEKIT_URL=http://127.0.0.1:7880
CONVIA_TEST_LIVEKIT_API_KEY=devkey
CONVIA_TEST_LIVEKIT_API_SECRET=a-development-secret-long-enough-to-be-accepted

# Where this instance reaches the Redis it shares with the other instances of
# the same deployment. Two things use it: the channel that carries control
# events between instances, and the store that holds presence.
#
# Unset means there are no other instances, which is what a local process is and
# what a single-instance deployment is. Everything works: every event-stream
# subscriber is served by the instance that produced the event, and presence is
# held in the process that was told about it.
#
# Several instances with this unset is the one configuration that is quietly
# wrong — each would serve only its own subscribers and hold only its own
# presence, and it would look like it worked. Convia cannot detect that from
# inside one process; docs/events.md and docs/presence.md state it as an
# operational requirement.
#
# The value below matches the local docker-compose.yml instance, which is
# opt-in:
#
#   docker compose --profile shared up -d
#
# Nothing durable is ever written here. The events are carried over
# publish/subscribe, which stores nothing at all; presence is the only thing
# that writes a key, and every one of them expires. Production requires rediss,
# because both carry the affairs of every tenant on the deployment between
# machines.
CONVIA_REDIS_URL=redis://127.0.0.1:6379/0
CONVIA_REDIS_TIMEOUT=3s

# Enables the integration tests that need Redis, which are skipped unless it is
# set: carrying events between instances, and presence converging across them.
#
# Point it at a database of its own. The relay tests use a channel of their own
# and store nothing, but the presence tests empty the database they run in,
# which is how one test's expired claims are kept out of another's sweep.
CONVIA_TEST_REDIS_URL=redis://127.0.0.1:6379/1
