# What is never versioned, whatever the stack turns out to be. Patterns
# specific to a language or framework are added when that choice is made
# (AGENTS.md, rule 3), not before.

# Local configuration and secrets of each machine.
.env
.env.*
!.env.example

# Build output.
dist/
build/
out/
bin/

# Compiled binaries, libraries and installers.
*.exe
*.dll
*.so
*.dylib
*.msi
*.msix
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage

# Dependencies fetched by a package manager.
node_modules/

# Test, coverage and profiling output.
coverage/
*.test
*.out
*.prof

# Logs and temporary files.
*.log
tmp/
temp/

# Editors and tools, as each person configures them locally.
.idea/
*.swp
*~
.claude/settings.local.json

# Operating systems.
.DS_Store
Thumbs.db
desktop.ini
